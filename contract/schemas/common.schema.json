{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeroion.local/schemas/common.schema.json",
  "title": "AeroIon-Edge common definitions",
  "description": "Shared types and enumerations used by every message. Single source of truth: the C header and the reference doc are generated from these files.",
  "x-aeroion-version": "1.3",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version as MAJOR.MINOR. Consumers accept any message with the same MAJOR."
    },
    "node_id": {
      "type": "string",
      "pattern": "^n[0-9]{2}$",
      "description": "Node identifier, n01 to n99."
    },
    "ts": {
      "type": "integer",
      "minimum": 1600000000000,
      "description": "Unix time in milliseconds, UTC."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-node counter, +1 for every telemetry, event and wave message. Gaps mean lost messages; repeats mean duplicates."
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_fraction": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9A-F]{8,20}$",
      "description": "RFID tag UID as upper-case hex, 4 to 10 bytes."
    },
    "state": {
      "enum": ["LOCKED", "ARMED", "HARVEST", "BACKOFF", "SAFE", "MAINTENANCE"],
      "description": "Node state machine (M3)."
    },
    "event_type": {
      "enum": ["FOG_DETECTED", "FOG_CLEARED", "ARC_PREDICTED", "ARC", "STATE_CHANGE", "BADGE_TAP", "FAULT",
               "MAINT_ON", "MAINT_OFF", "CMD_ACK"]
    },
    "cmd_type": {
      "enum": ["SET_HINT", "PREARM", "LOCK", "SYNC_ALLOWLIST", "TARE"]
    },
    "fault_code": {
      "enum": ["SENSOR_FAIL", "HV_OVERCURRENT", "WATCHDOG", "LID_OPEN", "COMM_LOST", "CLOCK_UNSYNCED", "OTHER"]
    },
    "role": {
      "enum": ["operator", "technician", "admin", "household", "unknown"]
    },
    "badge_action": {
      "enum": ["arm", "disarm", "maint_on", "maint_off", "dispense", "none"]
    },
    "badge_result": {
      "enum": ["granted", "denied"]
    },
    "ack_result": {
      "enum": ["accepted", "rejected", "expired"]
    },
    "fog_source": {
      "enum": ["optical", "virtual"]
    },
    "wave_trigger": {
      "enum": ["ARC", "ARC_PREDICTED", "MANUAL", "NOVEL"]
    }
  }
}
